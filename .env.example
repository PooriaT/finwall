# environment
FINWALL_ENV=development

# storage
FINWALL_STORAGE_BACKEND=sqlite
FINWALL_DATABASE_URL=
FINWALL_DATABASE_PATH=finwall.db

# market data
FINWALL_MARKET_DATA_PROVIDER=static
FINWALL_MARKET_DATA_TIMEOUT_SECONDS=5

# fundamentals
FINWALL_FUNDAMENTAL_DATA_PROVIDER=static
FINWALL_FUNDAMENTAL_DATA_TIMEOUT_SECONDS=5

# news
FINWALL_NEWS_PROVIDER=static
FINWALL_NEWS_TIMEOUT_SECONDS=5
FINWALL_NEWS_MAX_ARTICLES_PER_TOPIC=5
FINWALL_NEWS_MAX_AGE_HOURS=72

# narrative
FINWALL_NARRATIVE_PROVIDER=disabled
FINWALL_NARRATIVE_MAX_WORDS=500
FINWALL_NARRATIVE_STYLE=plain_english

# email
FINWALL_EMAIL_PROVIDER=disabled
FINWALL_EMAIL_FROM=
FINWALL_EMAIL_TO=
FINWALL_EMAIL_TIMEOUT_SECONDS=10
FINWALL_SMTP_HOST=
FINWALL_SMTP_PORT=587
FINWALL_SMTP_USERNAME=
FINWALL_SMTP_PASSWORD=
FINWALL_SMTP_USE_STARTTLS=true

# API/admin
FINWALL_API_ENABLED=false
FINWALL_API_TOKEN=
FINWALL_API_HOST=127.0.0.1
FINWALL_API_PORT=8000
